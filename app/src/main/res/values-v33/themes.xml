<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 13(API 33)부터 지원하는 단어 단위 줄바꿈. 기본값은 한국어를 글자 단위로 끊어서
      "바꿀 수 있어/요"처럼 단어가 잘린다. 모든 TextView에 phrase 줄바꿈을 적용한다.
    -->
    <style name="Theme.SubscriptionManagement" parent="Base.Theme.SubscriptionManagement">
        <item name="android:textViewStyle">@style/Widget.Gudok.TextView.Phrase</item>
    </style>

    <style name="Widget.Gudok.TextView.Phrase" parent="Widget.Gudok.TextView">
        <item name="android:lineBreakWordStyle">phrase</item>
    </style>
</resources>
