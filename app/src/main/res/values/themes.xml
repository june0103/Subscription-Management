<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.SubscriptionManagement" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <!--
          글꼴은 테마의 android:fontFamily로 주지 않는다. 테마 값이 각 TextAppearance의
          글꼴을 덮어써서 세미볼드(600) 스타일이 모두 보통 굵기로 보였다.
          대신 기본 TextView 스타일과 Material 글자 스타일에 Plex를 넣는다.
        -->
        <item name="android:textViewStyle">@style/Widget.Gudok.TextView</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Gudok.M3.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Gudok.M3.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Gudok.M3.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Gudok.M3.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Gudok.M3.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Gudok.M3.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Gudok.M3.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Gudok.M3.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Gudok.M3.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Gudok.M3.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Gudok.M3.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Gudok.M3.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Gudok.M3.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Gudok.M3.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Gudok.M3.LabelSmall</item>

        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/surface_sunken</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSecondaryContainer">@color/surface_sunken</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_2</item>
        <item name="colorSurfaceVariant">@color/surface_sunken</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_sunken</item>
        <item name="colorOutline">@color/line_strong</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/due_today</item>
        <item name="colorOnError">@color/on_due_today</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:textColorHint">@color/ink_3</item>

        <!-- 그림자 높이에 따라 면에 남색 틴트를 섞지 않는다. 면 색은 토큰 그대로. -->
        <item name="elevationOverlayEnabled">false</item>

        <item name="toolbarStyle">@style/Widget.Gudok.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.Gudok.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.Gudok.TextInput</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Gudok.BottomSheet</item>
        <item name="materialSwitchStyle">@style/Widget.Gudok.Switch</item>
    </style>

    <!-- 앱 테마. Android 13+에서는 values-v33에서 한국어 줄바꿈을 단어 단위로 바꾼다. -->
    <style name="Theme.SubscriptionManagement" parent="Base.Theme.SubscriptionManagement" />

    <style name="ThemeOverlay.Gudok.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="bottomSheetStyle">@style/Widget.Gudok.BottomSheet</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <style name="Widget.Gudok.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Gudok.Sheet</item>
    </style>

    <style name="ShapeAppearance.Gudok.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_lg</item>
        <item name="cornerSizeTopRight">@dimen/radius_lg</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.Gudok.Md" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <style name="ShapeAppearance.Gudok.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
