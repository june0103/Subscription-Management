<?xml version="1.0" encoding="utf-8"?>
<!--
  구독체크 디자인 시스템의 타입 스케일과 컴포넌트 스타일.
  글꼴: IBM Plex Sans KR (res/font). 본문 400·굵게 700은 @font/ibm_plex_sans_kr, 600은 semibold 파일.
-->
<resources>

    <!-- 숫자 -->
    <style name="TextAppearance.Gudok.AmountHero" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">34sp</item>
        <item name="lineHeight">40sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- 요약 카드의 두 번째 통화(+ $30.99). 첫 통화보다 한 단계 작지만 같은 흰 굵은 숫자 -->
    <style name="TextAppearance.Gudok.AmountHeroSecondary" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="lineHeight">32sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.Gudok.DateDay" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="lineHeight">28sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.Gudok.ValueLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="lineHeight">28sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- 텍스트 -->
    <style name="TextAppearance.Gudok.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="lineHeight">32sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Gudok.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">26sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Gudok.BodyStrong" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Gudok.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="lineHeight">22sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Gudok.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="lineHeight">18sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ink_2</item>
    </style>

    <!-- 13sp 보통 굵기. 설명 문장(설정 부제, 시트 안내, 요약 줄)에 쓴다. Label은 굵은 라벨용. -->
    <style name="TextAppearance.Gudok.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="lineHeight">18sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ink_2</item>
    </style>

    <style name="TextAppearance.Gudok.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ink_2</item>
    </style>

    <!-- 컴포넌트 -->
    <style name="Widget.Gudok.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg</item>
        <item name="titleTextAppearance">@style/TextAppearance.Gudok.Title</item>
        <item name="titleTextColor">@color/ink</item>
        <item name="navigationIconTint">@color/ink</item>
    </style>

    <style name="Widget.Gudok.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAppearance">@style/TextAppearance.Gudok.BodyStrong</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Gudok.Pill</item>
    </style>

    <style name="Widget.Gudok.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Gudok.BodyStrong</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/line_strong</item>
        <item name="iconTint">@color/ink</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Gudok.Pill</item>
    </style>

    <style name="Widget.Gudok.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Gudok.BodyStrong</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink_2</item>
    </style>

    <style name="Widget.Gudok.Button.Danger" parent="Widget.Gudok.Button.Text">
        <item name="android:textColor">@color/due_today_ink</item>
    </style>

    <style name="Widget.Gudok.Button.Stepper" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/ink</item>
        <item name="strokeColor">@color/line_strong</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Gudok.Pill</item>
    </style>

    <style name="Widget.Gudok.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/ink</item>
        <item name="iconSize">24dp</item>
    </style>

    <style name="Widget.Gudok.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/TextAppearance.Gudok.Chip</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Gudok.Pill</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
    </style>

    <style name="TextAppearance.Gudok.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Gudok.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="hintEnabled">false</item>
        <item name="errorTextColor">@color/due_today_ink</item>
        <item name="boxStrokeErrorColor">@color/due_today</item>
        <item name="errorIconDrawable">@null</item>
        <item name="suffixTextColor">@color/ink_2</item>
        <item name="prefixTextColor">@color/ink_2</item>
        <item name="helperTextTextColor">@color/ink_2</item>
    </style>

    <!-- 한 줄 입력칸 안의 EditText. 서비스 이름과 금액이 같은 높이·글자 크기를 쓴다. -->
    <style name="Widget.Gudok.EditText.SingleLine" parent="">
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:paddingTop">@dimen/space_3</item>
        <item name="android:paddingBottom">@dimen/space_3</item>
        <item name="android:maxLines">1</item>
        <!-- Plex의 위아래 여백 때문에 52dp보다 커지지 않게 한다 -->
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Gudok.BodyStrong</item>
    </style>

    <style name="Widget.Gudok.TextInput.Search" parent="Widget.Gudok.TextInput">
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/surface_sunken</item>
        <item name="startIconTint">@color/ink_3</item>
    </style>

    <style name="Widget.Gudok.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackDecorationTint">@color/switch_track_decoration</item>
    </style>

    <!-- 둘 중 하나 고르기 (원화/달러, 매월/매년) -->
    <style name="Widget.Gudok.Segment" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_segment_item</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
    </style>

    <style name="Widget.Gudok.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/space_2</item>
        <item name="android:textAppearance">@style/TextAppearance.Gudok.Label</item>
    </style>

    <!-- DueLabel: 배경색은 DueTone에 따라 코드에서 backgroundTint로 바꾼다 -->
    <style name="Widget.Gudok.DueLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/due_label_height</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="android:textColor">@color/due_later_ink</item>
        <!-- 높이가 고정된 라벨이라, 글꼴 위쪽 여백(includeFontPadding)이 붙으면 글자가 아래로 쏠린다 -->
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Gudok.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/surface_sunken</item>
    </style>

    <style name="TextAppearance.Gudok.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr_semibold</item>
    </style>

    <style name="Widget.Gudok.Weekday" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="android:textColor">@color/ink_2</item>
    </style>

    <style name="Widget.Gudok.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/line</item>
    </style>


    <!-- 텍스트 스타일을 따로 주지 않은 TextView의 기본값 -->
    <style name="Widget.Gudok.TextView" parent="android:Widget.Material.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Gudok.Body</item>
    </style>

    <!-- Material 컴포넌트 기본 글자 스타일(시간 선택기, 스낵바 등)에 Plex를 입힌다 -->
    <style name="TextAppearance.Gudok.M3.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
    </style>
    <style name="TextAppearance.Gudok.M3.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
    </style>
    <style name="TextAppearance.Gudok.M3.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
    </style>
    <style name="TextAppearance.Gudok.M3.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
    </style>
    <style name="TextAppearance.Gudok.M3.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
    </style>
    <style name="TextAppearance.Gudok.M3.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
    </style>
    <style name="TextAppearance.Gudok.M3.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr_semibold</item>
    </style>
    <style name="TextAppearance.Gudok.M3.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr_semibold</item>
    </style>
    <style name="TextAppearance.Gudok.M3.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr_semibold</item>
    </style>
    <style name="TextAppearance.Gudok.M3.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
    </style>
    <style name="TextAppearance.Gudok.M3.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
    </style>
    <style name="TextAppearance.Gudok.M3.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
    </style>
    <style name="TextAppearance.Gudok.M3.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr_semibold</item>
    </style>
    <style name="TextAppearance.Gudok.M3.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr_semibold</item>
    </style>
    <style name="TextAppearance.Gudok.M3.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/ibm_plex_sans_kr_semibold</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr_semibold</item>
    </style>
</resources>
