<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_6"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="96dp">

            <!-- NextPaymentHeadline -->
            <TextView
                android:id="@+id/tvTodayDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Gudok.Label"
                tools:text="10월 1일 목요일" />

            <TextView
                android:id="@+id/tvHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.Gudok.Headline"
                tools:text="오늘 결제할 구독이 2개 있어요" />

            <TextView
                android:id="@+id/tvHeadlineSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.Gudok.Body"
                android:textColor="@color/ink_2"
                tools:text="10월 4일 (일) ChatGPT Plus $20.00" />

            <!-- TodayBanner -->
            <LinearLayout
                android:id="@+id/cardTodayBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:background="@drawable/bg_today_banner"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingVertical="@dimen/space_3"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/due_today_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTodayTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Gudok.BodyStrong"
                        android:textColor="@color/due_today_ink"
                        android:fontFamily="@font/ibm_plex_sans_kr"
                        android:textStyle="bold"
                        tools:text="오늘 22,790원이 결제돼요" />

                    <TextView
                        android:id="@+id/tvTodayNames"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Gudok.BodySmall"
                        android:textColor="@color/due_today_ink"
                        tools:text="YouTube Premium · 쿠팡 와우" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/due_today_ink" />
            </LinearLayout>

            <!-- SummaryHero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:padding="@dimen/space_6">

                <TextView
                    android:id="@+id/tvMonthlyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Gudok.Label"
                    android:textColor="@color/sand"
                    tools:text="10월 예상 지출" />

                <TextView
                    android:id="@+id/tvHeroAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:textAppearance="@style/TextAppearance.Gudok.AmountHero"
                    android:textColor="@color/on_brand"
                    tools:text="72,480원" />

                <TextView
                    android:id="@+id/tvHeroSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Gudok.BodyStrong"
                    android:textColor="@color/on_brand_2"
                    tools:text="+ $30.99" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="@color/brand_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardMonthlySubscriptions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_2">

                        <TextView
                            android:id="@+id/tvMonthlyCountValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Gudok.BodyStrong"
                            android:textColor="@color/on_brand"
                            android:fontFamily="@font/ibm_plex_sans_kr"
                            android:textStyle="bold"
                            tools:text="9개" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_monthly_count_title"
                            android:textAppearance="@style/TextAppearance.Gudok.Caption"
                            android:textColor="@color/on_brand_2" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardAnnualSubscriptions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_2">

                        <TextView
                            android:id="@+id/tvAnnualCountValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Gudok.BodyStrong"
                            android:textColor="@color/on_brand"
                            android:fontFamily="@font/ibm_plex_sans_kr"
                            android:textStyle="bold"
                            tools:text="1개" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_annual_count_title"
                            android:textAppearance="@style/TextAppearance.Gudok.Caption"
                            android:textColor="@color/on_brand_2" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_2">

                        <TextView
                            android:id="@+id/tvDueThisWeekValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Gudok.BodyStrong"
                            android:textColor="@color/on_brand"
                            android:fontFamily="@font/ibm_plex_sans_kr"
                            android:textStyle="bold"
                            tools:text="4건" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_due_this_week_title"
                            android:textAppearance="@style/TextAppearance.Gudok.Caption"
                            android:textColor="@color/on_brand_2" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 다가오는 결제 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/home_upcoming_title"
                    android:textAppearance="@style/TextAppearance.Gudok.Title" />

                <TextView
                    android:id="@+id/tvViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_2"
                    android:text="@string/home_more"
                    android:textAppearance="@style/TextAppearance.Gudok.Label" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerUpcoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_timeline_group" />

            <LinearLayout
                android:id="@+id/cardHomeEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/bg_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_6"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/home_empty_body"
                    android:textAppearance="@style/TextAppearance.Gudok.Body"
                    android:textColor="@color/ink_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonEmptyAdd"
                    style="@style/Widget.Gudok.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:paddingHorizontal="@dimen/space_6"
                    android:text="@string/home_add_subscription" />
            </LinearLayout>

            <!-- 카테고리별 지출: 요약 카드와 같은 이번 달 결제 기준 -->
            <LinearLayout
                android:id="@+id/sectionCategorySpend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/home_category_title"
                        android:textAppearance="@style/TextAppearance.Gudok.Title" />

                    <TextView
                        android:id="@+id/tvCategoryBasis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Gudok.Caption"
                        android:textColor="@color/ink_3"
                        tools:text="10월 결제 기준" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerCategorySpend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_4"
                    android:paddingVertical="@dimen/space_2" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddSubscription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_gutter"
        android:contentDescription="@string/home_add_subscription"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Gudok.Pill"
        app:tint="@color/on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
