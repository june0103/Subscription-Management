<?xml version="1.0" encoding="utf-8"?>
<!-- SubscriptionRow: 아이콘 · 서비스명 · 메타 · 금액 · DueLabel. 카드 안에 구분선으로 쌓는다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_4"
    android:paddingVertical="@dimen/space_3">

    <FrameLayout
        android:layout_width="@dimen/service_icon"
        android:layout_height="@dimen/service_icon">

        <ImageView
            android:id="@+id/ivServiceIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_service_badge"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="N" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Gudok.BodyStrong"
            tools:text="Netflix" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Gudok.Caption"
            tools:text="매월 2일 · 1일 전 알림" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Gudok.BodyStrong"
            tools:text="17,000원" />

        <TextView
            android:id="@+id/tvDueLabel"
            style="@style/Widget.Gudok.DueLabel"
            android:layout_marginTop="@dimen/space_1"
            tools:text="내일 결제" />
    </LinearLayout>
</LinearLayout>
