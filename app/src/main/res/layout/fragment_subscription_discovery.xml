<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDiscovery"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_chevron_left"
        app:title="@string/discovery_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/screen_gutter">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Gudok.TextInput.Search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/discovery_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:minHeight="52dp"
                android:textAppearance="@style/TextAppearance.Gudok.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/discovery_privacy_note"
            android:textAppearance="@style/TextAppearance.Gudok.Label"
            android:textColor="@color/ink_2" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_4"
            android:layout_weight="1">

            <ListView
                android:id="@+id/listSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:clipToPadding="false"
                android:divider="@drawable/divider_line"
                android:dividerHeight="1dp"
                android:listSelector="@android:color/transparent"
                android:paddingVertical="1dp" />

            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_6"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/discovery_empty_title"
                    android:textAppearance="@style/TextAppearance.Gudok.BodyStrong" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:gravity="center"
                    android:text="@string/discovery_empty_body"
                    android:textAppearance="@style/TextAppearance.Gudok.Body"
                    android:textColor="@color/ink_2" />
            </LinearLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressDiscovery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_8"
                android:indeterminate="true"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/surface_sunken" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
