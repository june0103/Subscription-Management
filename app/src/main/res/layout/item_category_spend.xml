<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.Gudok.BodyStrong"
            tools:text="AI" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Gudok.Caption"
            android:textColor="@color/ink_3"
            tools:text="2개" />

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Gudok.BodyStrong"
            tools:text="$40.00" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:importantForAccessibility="no"
        android:max="1000"
        app:trackColor="@color/surface_sunken"
        app:trackCornerRadius="3dp"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="6dp"
        app:indicatorTrackGapSize="0dp"
        tools:progress="600" />
</LinearLayout>
