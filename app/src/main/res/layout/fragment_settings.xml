<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_6"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_6">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.Gudok.Headline" />

        <TextView
            style="@style/Widget.Gudok.SectionLabel"
            android:layout_marginTop="@dimen/space_6"
            android:accessibilityHeading="true"
            android:text="@string/settings_section_notifications" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:divider="@drawable/divider_line"
            android:orientation="vertical"
            android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingVertical="@dimen/space_3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/switchNotifications"
                        android:text="@string/settings_notifications_title"
                        android:textAppearance="@style/TextAppearance.Gudok.BodyStrong" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_notifications_subtitle"
                        android:textAppearance="@style/TextAppearance.Gudok.Label"
                        android:textColor="@color/ink_2" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:contentDescription="@string/settings_notifications_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutReminderTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingVertical="@dimen/space_3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_time_title"
                        android:textAppearance="@style/TextAppearance.Gudok.BodyStrong" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_time_subtitle"
                        android:textAppearance="@style/TextAppearance.Gudok.Label"
                        android:textColor="@color/ink_2" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvReminderTimeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/space_3"
                    android:background="@drawable/bg_picker_field"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:textAppearance="@style/TextAppearance.Gudok.BodyStrong"
                    tools:text="오전 9:00" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvNotificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:background="@drawable/bg_status_banner"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textAppearance="@style/TextAppearance.Gudok.Label"
            tools:text="매일 오전 9:00에 결제 예정 구독을 확인해 알려드려요." />

        <TextView
            style="@style/Widget.Gudok.SectionLabel"
            android:layout_marginTop="@dimen/space_6"
            android:accessibilityHeading="true"
            android:text="@string/settings_section_app" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:divider="@drawable/divider_line"
            android:orientation="vertical"
            android:showDividers="middle">

            <!-- 방침 주소(privacy_policy_url)가 비어 있으면 숨긴다 -->
            <LinearLayout
                android:id="@+id/rowPrivacyPolicy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_4">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_privacy_policy"
                    android:textAppearance="@style/TextAppearance.Gudok.BodyStrong" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_4">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_version"
                    android:textAppearance="@style/TextAppearance.Gudok.BodyStrong" />

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Gudok.Body"
                    android:textColor="@color/ink_2"
                    tools:text="1.0.1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
