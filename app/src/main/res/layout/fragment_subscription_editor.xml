<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarEditor"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_close"
        app:navigationIcon="@drawable/ic_close"
        tools:title="구독 추가" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_6">

            <!-- 설치된 앱에서 찾기 -->
            <LinearLayout
                android:id="@+id/buttonDiscoverServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:padding="@dimen/space_4">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_tile">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_apps_search"
                        app:tint="@color/on_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/editor_discover_title"
                        android:textAppearance="@style/TextAppearance.Gudok.BodyStrong" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/editor_discover_body"
                        android:textAppearance="@style/TextAppearance.Gudok.Label"
                        android:textColor="@color/ink_2" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- 서비스 -->
            <TextView
                style="@style/Widget.Gudok.SectionLabel"
                android:layout_marginTop="28dp"
                android:labelFor="@id/editServiceName"
                android:text="@string/editor_label_service_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilServiceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/editServiceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:completionThreshold="1"
                    android:dropDownHeight="wrap_content"
                    android:hint="@string/editor_hint_service_name"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:minHeight="52dp"
                    android:paddingHorizontal="@dimen/space_4"
                    android:textAppearance="@style/TextAppearance.Gudok.BodyStrong" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 금액 -->
            <TextView
                style="@style/Widget.Gudok.SectionLabel"
                android:layout_marginTop="28dp"
                android:labelFor="@id/editAmount"
                android:text="@string/editor_label_amount" />

            <RadioGroup
                android:id="@+id/groupCurrency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_track"
                android:contentDescription="@string/editor_label_currency"
                android:orientation="horizontal"
                android:padding="4dp">

                <RadioButton
                    android:id="@+id/radioKrw"
                    style="@style/Widget.Gudok.Segment"
                    android:checked="true"
                    android:text="@string/editor_currency_krw" />

                <RadioButton
                    android:id="@+id/radioUsd"
                    style="@style/Widget.Gudok.Segment"
                    android:text="@string/editor_currency_usd" />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                app:prefixTextAppearance="@style/TextAppearance.Gudok.ValueLarge"
                app:suffixTextAppearance="@style/TextAppearance.Gudok.ValueLarge">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/editor_hint_amount"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:minHeight="56dp"
                    android:textAppearance="@style/TextAppearance.Gudok.ValueLarge" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 결제일 -->
            <TextView
                style="@style/Widget.Gudok.SectionLabel"
                android:layout_marginTop="28dp"
                android:text="@string/editor_label_billing_day" />

            <RadioGroup
                android:id="@+id/groupCycle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_track"
                android:contentDescription="@string/editor_label_cycle"
                android:orientation="horizontal"
                android:padding="4dp">

                <RadioButton
                    android:id="@+id/radioMonthly"
                    style="@style/Widget.Gudok.Segment"
                    android:checked="true"
                    android:text="@string/editor_cycle_monthly" />

                <RadioButton
                    android:id="@+id/radioAnnual"
                    style="@style/Widget.Gudok.Segment"
                    android:text="@string/editor_cycle_annual" />
            </RadioGroup>

            <!-- PickerField -->
            <LinearLayout
                android:id="@+id/pickerBillingDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/bg_picker_field"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingVertical="@dimen/space_3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBillingValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Gudok.ValueLarge"
                        tools:text="매월 2일" />

                    <TextView
                        android:id="@+id/tvBillingHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Gudok.Caption"
                        tools:text="다음 결제 10월 2일 (금) · 내일" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- 알림 시점 -->
            <TextView
                style="@style/Widget.Gudok.SectionLabel"
                android:layout_marginTop="28dp"
                android:text="@string/editor_label_reminder" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_2"
                app:chipSpacingVertical="0dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReminder0"
                    style="@style/Widget.Gudok.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reminder_same_day" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReminder1"
                    style="@style/Widget.Gudok.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="1일 전" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReminder3"
                    style="@style/Widget.Gudok.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="3일 전" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReminderCustom"
                    style="@style/Widget.Gudok.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reminder_custom" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tvReminderHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.Gudok.Caption"
                tools:text="10월 1일 오전 9:00에 알려드려요. 알림 시각은 설정에서 바꿀 수 있어요." />

            <!-- 카테고리 -->
            <TextView
                style="@style/Widget.Gudok.SectionLabel"
                android:layout_marginTop="28dp"
                android:text="@string/editor_label_category" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_2"
                app:chipSpacingVertical="0dp"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/tvCategoryHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/editor_category_auto_hint"
                android:textAppearance="@style/TextAppearance.Gudok.Caption"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- 결제수단 -->
            <TextView
                android:id="@+id/tvPaymentLabel"
                style="@style/Widget.Gudok.SectionLabel"
                android:layout_marginTop="28dp"
                tools:text="결제수단 (선택)" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_2"
                app:chipSpacingVertical="0dp"
                app:singleSelection="true" />

            <!-- 메모 -->
            <TextView
                android:id="@+id/tvMemoLabel"
                style="@style/Widget.Gudok.SectionLabel"
                android:layout_marginTop="28dp"
                android:labelFor="@id/editMemo"
                tools:text="메모 (선택)" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:counterEnabled="true"
                app:counterMaxLength="500"
                app:counterTextColor="@color/ink_3">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editMemo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="@string/editor_memo_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="500"
                    android:minHeight="104dp"
                    android:minLines="3"
                    android:textAppearance="@style/TextAppearance.Gudok.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDelete"
                style="@style/Widget.Gudok.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/editor_button_delete"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 하단 고정: 요약 + 저장 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_3"
        android:paddingBottom="@dimen/space_4">

        <LinearLayout
            android:id="@+id/layoutSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSummaryDue"
                style="@style/Widget.Gudok.DueLabel"
                tools:text="내일 결제" />

            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Gudok.Label"
                tools:text="10월 2일 17,000원 · 10월 1일에 알림" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSave"
            style="@style/Widget.Gudok.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_button_save" />
    </LinearLayout>
</LinearLayout>
